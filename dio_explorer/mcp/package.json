{
  "name": "dio-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server for DIO Explorer — expõe as tools /trilha, /desafio e /certificado via stdio, HTTP ou SSE",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "DIO_TRANSPORT=http node build/index.js",
    "start:sse": "DIO_TRANSPORT=sse node build/index.js",
    "dev": "tsc --watch"
  },
  "bin": {
    "dio-explorer-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
